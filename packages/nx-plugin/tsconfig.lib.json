{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    // The esbuild bundle targets node20, so no helper is ever imported: tslib isn't a dependency.
    "importHelpers": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../template-engine/tsconfig.lib.json"
    },
    {
      "path": "../shared/tsconfig.lib.json"
    },
    {
      "path": "../integrations/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
