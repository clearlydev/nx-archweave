// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`fast workflow is byte-pinned 1`] = `
"name: Gemini Code Review

on:
  pull_request:
    types: [opened, synchronize, ready_for_review, reopened]

concurrency:
  group: archweave-review-\${{ github.event.pull_request.number }}
  cancel-in-progress: false

permissions: {}

jobs:
  ai-review:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: write
    outputs:
      enabled: \${{ steps.secret-gate.outputs.enabled }}
      allowed: \${{ steps.round-gate.outputs.allowed }}
      last-comment-id: \${{ steps.round-gate.outputs.last-comment-id }}
    steps:
      - name: Check review secret
        id: secret-gate
        env:
          REVIEW_SECRET: \${{ secrets.GEMINI_API_KEY }}
        run: |
          if [ -z "$REVIEW_SECRET" ]; then
            echo "AI review is not active: register the GEMINI_API_KEY secret to enable it."
            echo "enabled=false" >> "$GITHUB_OUTPUT"
          else
            echo "enabled=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Check review round limit
        id: round-gate
        if: steps.secret-gate.outputs.enabled == 'true'
        env:
          GH_TOKEN: \${{ github.token }}
        run: |
          counts=$(gh api "repos/\${{ github.repository }}/issues/\${{ github.event.pull_request.number }}/comments" --paginate --jq '[([.[] | select(.user.type == "Bot") | select(.body | contains("<!-- archweave-review-round -->"))] | length), ([.[].id] | max // 0)]' | jq -s -r '[(map(.[0]) | add // 0), (map(.[1]) | max // 0)] | @tsv')
          rounds=$(printf '%s' "$counts" | cut -f1)
          echo "last-comment-id=$(printf '%s' "$counts" | cut -f2)" >> "$GITHUB_OUTPUT"
          if [ "$rounds" -ge 3 ]; then
            echo "Automated review round limit (3) reached for this PR; skipping."
            echo "allowed=false" >> "$GITHUB_OUTPUT"
          else
            echo "allowed=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Checkout repository
        if: steps.secret-gate.outputs.enabled == 'true' && steps.round-gate.outputs.allowed == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false

      - name: Run Gemini review
        if: steps.secret-gate.outputs.enabled == 'true' && steps.round-gate.outputs.allowed == 'true'
        uses: google-github-actions/run-gemini-cli@f77273f4c914e4bf38440cf36a0369cb64a37489 # v0.1.22
        env:
          GITHUB_TOKEN: \${{ github.token }}
          GEMINI_CLI_TRUST_WORKSPACE: 'true'
        with:
          gemini_api_key: \${{ secrets.GEMINI_API_KEY }}
          gemini_cli_version: '0.65.0'
          prompt: |
            Review the diff of this pull request using \`gh pr diff\` and \`gh pr view\`.
            Post specific findings as inline comments and exactly one top-level summary comment.
            Always include the literal marker <!-- archweave-review-round --> in the top-level summary comment.
            If there are no findings that require action, post exactly one top-level comment saying so (and still include the marker).
            Do not modify any code, and never approve or merge the pull request.
            Write summaries and explanations in English; keep file names, function names, and identifiers verbatim.

            ---

            You are a code reviewer focused on correctness and security.

            Review the provided diff and report only the most critical problems. Skip minor style and taste remarks entirely — report nothing below P2.

            Only report findings with priority P0, P1, P2. Do NOT report P3 (over-engineering) findings — they are out of scope here.

            For every finding, fill in every field of this schema:
            - priority: P0 | P1 | P2
            - category: kebab-case category name
            - title: one-line summary
            - file: path of the affected file
            - lineRange: { start, end? }
            - evidence: what in the code proves the problem
            - impact: what goes wrong and for whom
            - reproductionCondition: the exact input/state that triggers it
            - recommendation: the concrete fix
            - confidence: confirmed | plausible

            If multiple findings share the same root cause, merge them into a single finding instead of reporting duplicates.

            ---

            At the END of the top-level summary comment, append the machine-readable findings block:
            the literal marker line <!-- archweave-findings-v1 -->, then a fenced \`\`\`json block containing
            { "schema": "archweave/findings@1", "findings": [ ... ] } with one entry per finding,
            using exactly the finding schema above. If there are no findings, still append the block with an empty findings array.

  review:
    needs: ai-review
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
    outputs:
      comment-body: \${{ steps.verdict.outputs.comment-body || steps.ai-review-result.outputs.notice-body }}
      previous-comment-id: \${{ steps.verdict.outputs.previous-comment-id }}
    steps:
      - name: Check the AI review result
        id: ai-review-result
        env:
          AI_REVIEW_RESULT: \${{ needs.ai-review.result }}
          REVIEW_ENABLED: \${{ needs.ai-review.outputs.enabled }}
          REVIEW_ALLOWED: \${{ needs.ai-review.outputs.allowed }}
          LAST_COMMENT_ID: \${{ needs.ai-review.outputs.last-comment-id }}
          HEAD_SHA: \${{ github.event.pull_request.head.sha }}
          HEAD_REPOSITORY: \${{ github.event.pull_request.head.repo.full_name }}
          REPOSITORY: \${{ github.repository }}
          PR_AUTHOR: \${{ github.event.pull_request.user.login }}
        run: |
          not_run() {
            case "$1" in
              secret) annotation='AI review did not run for this commit (the GEMINI_API_KEY secret is not registered). A green check here does not mean the change was reviewed.'; notice='AI review did not run for this commit (the GEMINI_API_KEY secret is not registered). A green check here does not mean the change was reviewed.' ;;
              fork) annotation='AI review did not run for this commit (this pull request comes from a fork, and GitHub passes no secrets to runs from forks). A green check here does not mean the change was reviewed.'; notice='AI review did not run for this commit (this pull request comes from a fork, and GitHub passes no secrets to runs from forks). A green check here does not mean the change was reviewed.' ;;
              dependabot) annotation='AI review did not run for this commit (Dependabot runs receive only Dependabot secrets, and GEMINI_API_KEY is not one of them). A green check here does not mean the change was reviewed.'; notice='AI review did not run for this commit (Dependabot runs receive only Dependabot secrets, and GEMINI_API_KEY is not one of them). A green check here does not mean the change was reviewed.' ;;
              rounds) annotation='AI review did not run for this commit (the automated review round limit (3) is reached). A green check here does not mean the change was reviewed.'; notice='AI review did not run for this commit (the automated review round limit (3) is reached). A green check here does not mean the change was reviewed.' ;;
            esac
            echo "::notice title=AI review did not run::$annotation"
            printf '%s\\n' "$notice" >> "$GITHUB_STEP_SUMMARY"
            short_sha=$(printf '%s' "$HEAD_SHA" | cut -c1-7)
            case "$short_sha" in
              '' | *[!0-9a-f]*) short_sha= ;;
            esac
            {
              echo "notice-body<<ARCHWEAVE_NOT_RUN_EOF"
              printf '%s\\n' '<!-- archweave-verdict -->' "ℹ️ $notice"
              if [ -n "$short_sha" ]; then printf '\\n%s\\n' '<sub>Commit \`'"$short_sha"'\` · this comment is updated on every review round.</sub>'; fi
              echo "ARCHWEAVE_NOT_RUN_EOF"
              echo "run=false"
            } >> "$GITHUB_OUTPUT"
          }
          if [ "$AI_REVIEW_RESULT" != success ]; then
            echo "::error title=AI review did not succeed::The AI review job ended with '$AI_REVIEW_RESULT'."
            exit 1
          fi
          case "$REVIEW_ENABLED/$REVIEW_ALLOWED" in
            false/*)
              if [ "$HEAD_REPOSITORY" != "$REPOSITORY" ]; then not_run fork
              elif [ "$PR_AUTHOR" = 'dependabot[bot]' ]; then not_run dependabot
              else not_run secret
              fi
              exit 0
              ;;
            true/false)
              not_run rounds
              exit 0
              ;;
            true/true)
              case "$LAST_COMMENT_ID" in
                '' | *[!0-9]*) ;;
                *)
                  echo "run=true" >> "$GITHUB_OUTPUT"
                  exit 0
                  ;;
              esac
              ;;
          esac
          echo "::error title=Review verdict not computed::The AI review job's results did not reach this job, so no verdict can be computed. Re-run all jobs."
          exit 1

      - name: Checkout repository
        if: steps.ai-review-result.outputs.run == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false

      - name: Detect pnpm version
        id: pnpm-version
        if: steps.ai-review-result.outputs.run == 'true'
        run: |
          if [ -n "$(jq -r '.packageManager // empty' package.json)" ]; then
            echo "version=" >> "$GITHUB_OUTPUT"
          else
            echo "version=10" >> "$GITHUB_OUTPUT"
          fi

      - name: Set up pnpm
        if: steps.ai-review-result.outputs.run == 'true'
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
          version: \${{ steps.pnpm-version.outputs.version }}

      - name: Set up Node
        if: steps.ai-review-result.outputs.run == 'true'
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          cache: pnpm

      - name: Install workspace dependencies
        if: steps.ai-review-result.outputs.run == 'true'
        run: |
          pnpm install --frozen-lockfile --ignore-scripts

      - name: Compute review verdict
        id: verdict
        if: steps.ai-review-result.outputs.run == 'true'
        env:
          GH_TOKEN: \${{ github.token }}
          GITHUB_REPOSITORY: \${{ github.repository }}
          ARCHWEAVE_PR_NUMBER: \${{ github.event.pull_request.number }}
          ARCHWEAVE_MAX_ROUNDS: '3'
          ARCHWEAVE_LOCALE: 'en'
          ARCHWEAVE_HEAD_SHA: \${{ github.event.pull_request.head.sha }}
          ARCHWEAVE_ROUND_AFTER_ID: \${{ needs.ai-review.outputs.last-comment-id }}
          ARCHWEAVE_VERDICT_OUTPUT: 'github-output'
        run: |
          if [ -x node_modules/.bin/archweave-review-verdict ]; then
            node_modules/.bin/archweave-review-verdict
          else
            echo "nx-archweave is not installed in this workspace - skipping the verdict gate."
          fi

      - name: Fail the review check
        if: steps.verdict.outputs.blocked == 'true'
        env:
          BLOCK_REASON: \${{ steps.verdict.outputs.block-reason }}
        run: |
          case "$BLOCK_REASON" in
            block) echo "The AI verdict is BLOCK: fix the P0/P1 findings in the verdict comment and push." ;;
            no-summary) echo "The AI review posted no summary for this commit, so there is no verdict. Re-run all jobs to review it again, or review it yourself." ;;
            unreadable) echo "The AI review summary has no readable findings block, so there is no verdict. Re-run all jobs to review it again, or review it yourself." ;;
            *) echo "The review check failed. See the verdict comment on this pull request." ;;
          esac
          exit 1

  review-comment:
    needs: review
    if: \${{ !cancelled() && needs.review.outputs.comment-body != '' }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      pull-requests: write
    steps:
      - name: Post review verdict
        env:
          GH_TOKEN: \${{ github.token }}
          REPOSITORY: \${{ github.repository }}
          PR_NUMBER: \${{ github.event.pull_request.number }}
          VERDICT_BODY: \${{ needs.review.outputs.comment-body }}
          PREVIOUS_ID: \${{ needs.review.outputs.previous-comment-id }}
        run: |
          payload=$(jq -n --arg body "$VERDICT_BODY" '{body: $body}')
          if [ -z "$PREVIOUS_ID" ]; then
            PREVIOUS_ID=$(gh api "repos/$REPOSITORY/issues/$PR_NUMBER/comments" --paginate --jq '.[] | select(.user.login == "github-actions[bot]") | select(.body | contains("<!-- archweave-verdict -->")) | .id' | tail -n 1) || PREVIOUS_ID=
          fi
          case "$PREVIOUS_ID" in
            ''|*[!0-9]*) PREVIOUS_ID= ;;
          esac
          if [ -n "$PREVIOUS_ID" ] && printf '%s' "$payload" | gh api -X PATCH "repos/$REPOSITORY/issues/comments/$PREVIOUS_ID" --input - > /dev/null; then
            exit 0
          fi
          printf '%s' "$payload" | gh api -X POST "repos/$REPOSITORY/issues/$PR_NUMBER/comments" --input - > /dev/null \\
            || echo "Could not post the verdict comment (continuing)."
"
`;

exports[`geminiProvider ko locale carries the ko policy prompts and workflow instructions 1`] = `
"name: Gemini Code Review

on:
  pull_request:
    types: [opened, synchronize, ready_for_review, reopened]

concurrency:
  group: archweave-review-\${{ github.event.pull_request.number }}
  cancel-in-progress: false

permissions: {}

jobs:
  ai-review:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: write
    outputs:
      enabled: \${{ steps.secret-gate.outputs.enabled }}
      allowed: \${{ steps.round-gate.outputs.allowed }}
      last-comment-id: \${{ steps.round-gate.outputs.last-comment-id }}
    steps:
      - name: Check review secret
        id: secret-gate
        env:
          REVIEW_SECRET: \${{ secrets.GEMINI_API_KEY }}
        run: |
          if [ -z "$REVIEW_SECRET" ]; then
            echo "AI review is not active: register the GEMINI_API_KEY secret to enable it."
            echo "enabled=false" >> "$GITHUB_OUTPUT"
          else
            echo "enabled=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Check review round limit
        id: round-gate
        if: steps.secret-gate.outputs.enabled == 'true'
        env:
          GH_TOKEN: \${{ github.token }}
        run: |
          counts=$(gh api "repos/\${{ github.repository }}/issues/\${{ github.event.pull_request.number }}/comments" --paginate --jq '[([.[] | select(.user.type == "Bot") | select(.body | contains("<!-- archweave-review-round -->"))] | length), ([.[].id] | max // 0)]' | jq -s -r '[(map(.[0]) | add // 0), (map(.[1]) | max // 0)] | @tsv')
          rounds=$(printf '%s' "$counts" | cut -f1)
          echo "last-comment-id=$(printf '%s' "$counts" | cut -f2)" >> "$GITHUB_OUTPUT"
          if [ "$rounds" -ge 5 ]; then
            echo "Automated review round limit (5) reached for this PR; skipping."
            echo "allowed=false" >> "$GITHUB_OUTPUT"
          else
            echo "allowed=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Checkout repository
        if: steps.secret-gate.outputs.enabled == 'true' && steps.round-gate.outputs.allowed == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false

      - name: Run Gemini review
        if: steps.secret-gate.outputs.enabled == 'true' && steps.round-gate.outputs.allowed == 'true'
        uses: google-github-actions/run-gemini-cli@f77273f4c914e4bf38440cf36a0369cb64a37489 # v0.1.22
        env:
          GITHUB_TOKEN: \${{ github.token }}
          GEMINI_CLI_TRUST_WORKSPACE: 'true'
        with:
          gemini_api_key: \${{ secrets.GEMINI_API_KEY }}
          gemini_cli_version: '0.65.0'
          prompt: |
            이 pull request의 diff를 \`gh pr diff\`와 \`gh pr view\`로 확인하고 리뷰하세요.
            구체적 지적은 inline comment로, 전체 요약은 정확히 한 개의 top-level comment로 게시하세요.
            top-level 요약 코멘트에는 반드시 리터럴 마커 <!-- archweave-review-round -->를 포함하세요.
            조치가 필요한 문제가 없으면 "조치가 필요한 문제를 찾지 못했습니다."라는 top-level comment를 정확히 한 개 게시하세요(이때도 마커는 포함).
            코드를 수정하지 마세요(Do not modify any code). PR을 승인하거나 병합하지 마세요(never approve or merge).
            요약과 설명은 한국어로 쓰되, 파일명·함수명·식별자는 원문 그대로 유지하세요.

            ---

            당신은 정확성(correctness)과 보안(security)에 집중하는 코드 리뷰어입니다.

            주어진 diff를 리뷰하고, finding을 "Correctness"와 "Security" 두 개의 최상위 섹션으로 분리해 보고하세요. 두 섹션을 절대 섞지 마세요.

            우선순위 P0, P1, P2, Nit에 해당하는 finding만 보고하세요. P3는 보고하지 마세요 — P3(과잉 설계)는 별도의 리뷰어가 담당하므로 이 리뷰의 범위 밖입니다.

            모든 finding에 대해 아래 스키마의 모든 필드를 채우세요:
            - priority: P0 | P1 | P2 | Nit
            - category: kebab-case category name
            - title: one-line summary
            - file: path of the affected file
            - lineRange: { start, end? }
            - evidence: what in the code proves the problem
            - impact: what goes wrong and for whom
            - reproductionCondition: the exact input/state that triggers it
            - recommendation: the concrete fix
            - confidence: confirmed | plausible

            같은 원인에서 나온 finding이 여러 개라면 중복 보고하지 말고 하나의 finding으로 합쳐서 보고하세요.

            ---

            당신은 과잉 설계(over-engineering)만을 전담하는 코드 리뷰어입니다.

            주어진 diff를 리뷰하고 우선순위 P3만 보고하세요. P0, P1, P2, Nit은 보고하지 마세요 — 정확성과 보안은 별도의 리뷰어가 담당합니다.

            finding은 "Over-engineering"이라는 별도의 최상위 섹션으로 보고하고, correctness/security 섹션과 절대 섞지 마세요.

            모든 finding에 대해 아래 스키마의 모든 필드를 채우세요:
            - priority: P3
            - category: kebab-case category name
            - title: one-line summary
            - file: path of the affected file
            - lineRange: { start, end? }
            - evidence: what in the code proves the problem
            - impact: what goes wrong and for whom
            - reproductionCondition: the exact input/state that triggers it
            - recommendation: the concrete fix
            - confidence: confirmed | plausible

            같은 원인에서 나온 finding이 여러 개라면 중복 보고하지 말고 하나의 finding으로 합쳐서 보고하세요.

            ---

            top-level 요약 코멘트의 맨 끝에 기계 판독용 findings 블록을 덧붙이세요:
            리터럴 마커 줄 <!-- archweave-findings-v1 --> 다음에 fenced \`\`\`json 블록으로
            { "schema": "archweave/findings@1", "findings": [ ... ] }를, finding마다 한 원소씩, 위 finding 스키마 그대로 작성하세요.
            finding이 없어도 빈 배열로 블록을 반드시 포함하세요.

  review:
    needs: ai-review
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
    outputs:
      comment-body: \${{ steps.verdict.outputs.comment-body || steps.ai-review-result.outputs.notice-body }}
      previous-comment-id: \${{ steps.verdict.outputs.previous-comment-id }}
    steps:
      - name: Check the AI review result
        id: ai-review-result
        env:
          AI_REVIEW_RESULT: \${{ needs.ai-review.result }}
          REVIEW_ENABLED: \${{ needs.ai-review.outputs.enabled }}
          REVIEW_ALLOWED: \${{ needs.ai-review.outputs.allowed }}
          LAST_COMMENT_ID: \${{ needs.ai-review.outputs.last-comment-id }}
          HEAD_SHA: \${{ github.event.pull_request.head.sha }}
          HEAD_REPOSITORY: \${{ github.event.pull_request.head.repo.full_name }}
          REPOSITORY: \${{ github.repository }}
          PR_AUTHOR: \${{ github.event.pull_request.user.login }}
        run: |
          not_run() {
            case "$1" in
              secret) annotation='AI review did not run for this commit (the GEMINI_API_KEY secret is not registered). A green check here does not mean the change was reviewed.'; notice='이 커밋에는 AI 리뷰가 실행되지 않았습니다(GEMINI_API_KEY 시크릿이 등록되지 않음). 이 green 체크는 변경 사항이 리뷰되었다는 뜻이 아닙니다.' ;;
              fork) annotation='AI review did not run for this commit (this pull request comes from a fork, and GitHub passes no secrets to runs from forks). A green check here does not mean the change was reviewed.'; notice='이 커밋에는 AI 리뷰가 실행되지 않았습니다(포크에서 온 pull request이고, GitHub는 포크 실행에 시크릿을 넘기지 않음). 이 green 체크는 변경 사항이 리뷰되었다는 뜻이 아닙니다.' ;;
              dependabot) annotation='AI review did not run for this commit (Dependabot runs receive only Dependabot secrets, and GEMINI_API_KEY is not one of them). A green check here does not mean the change was reviewed.'; notice='이 커밋에는 AI 리뷰가 실행되지 않았습니다(Dependabot 실행은 Dependabot 시크릿만 받는데, GEMINI_API_KEY는 그중에 없음). 이 green 체크는 변경 사항이 리뷰되었다는 뜻이 아닙니다.' ;;
              rounds) annotation='AI review did not run for this commit (the automated review round limit (5) is reached). A green check here does not mean the change was reviewed.'; notice='이 커밋에는 AI 리뷰가 실행되지 않았습니다(자동 리뷰 라운드 한도(5)에 도달함). 이 green 체크는 변경 사항이 리뷰되었다는 뜻이 아닙니다.' ;;
            esac
            echo "::notice title=AI review did not run::$annotation"
            printf '%s\\n' "$notice" >> "$GITHUB_STEP_SUMMARY"
            short_sha=$(printf '%s' "$HEAD_SHA" | cut -c1-7)
            case "$short_sha" in
              '' | *[!0-9a-f]*) short_sha= ;;
            esac
            {
              echo "notice-body<<ARCHWEAVE_NOT_RUN_EOF"
              printf '%s\\n' '<!-- archweave-verdict -->' "ℹ️ $notice"
              if [ -n "$short_sha" ]; then printf '\\n%s\\n' '<sub>커밋 \`'"$short_sha"'\` · 이 코멘트는 리뷰 라운드마다 갱신됩니다.</sub>'; fi
              echo "ARCHWEAVE_NOT_RUN_EOF"
              echo "run=false"
            } >> "$GITHUB_OUTPUT"
          }
          if [ "$AI_REVIEW_RESULT" != success ]; then
            echo "::error title=AI review did not succeed::The AI review job ended with '$AI_REVIEW_RESULT'."
            exit 1
          fi
          case "$REVIEW_ENABLED/$REVIEW_ALLOWED" in
            false/*)
              if [ "$HEAD_REPOSITORY" != "$REPOSITORY" ]; then not_run fork
              elif [ "$PR_AUTHOR" = 'dependabot[bot]' ]; then not_run dependabot
              else not_run secret
              fi
              exit 0
              ;;
            true/false)
              not_run rounds
              exit 0
              ;;
            true/true)
              case "$LAST_COMMENT_ID" in
                '' | *[!0-9]*) ;;
                *)
                  echo "run=true" >> "$GITHUB_OUTPUT"
                  exit 0
                  ;;
              esac
              ;;
          esac
          echo "::error title=Review verdict not computed::The AI review job's results did not reach this job, so no verdict can be computed. Re-run all jobs."
          exit 1

      - name: Checkout repository
        if: steps.ai-review-result.outputs.run == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false

      - name: Detect pnpm version
        id: pnpm-version
        if: steps.ai-review-result.outputs.run == 'true'
        run: |
          if [ -n "$(jq -r '.packageManager // empty' package.json)" ]; then
            echo "version=" >> "$GITHUB_OUTPUT"
          else
            echo "version=10" >> "$GITHUB_OUTPUT"
          fi

      - name: Set up pnpm
        if: steps.ai-review-result.outputs.run == 'true'
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
          version: \${{ steps.pnpm-version.outputs.version }}

      - name: Set up Node
        if: steps.ai-review-result.outputs.run == 'true'
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          cache: pnpm

      - name: Install workspace dependencies
        if: steps.ai-review-result.outputs.run == 'true'
        run: |
          pnpm install --frozen-lockfile --ignore-scripts

      - name: Compute review verdict
        id: verdict
        if: steps.ai-review-result.outputs.run == 'true'
        env:
          GH_TOKEN: \${{ github.token }}
          GITHUB_REPOSITORY: \${{ github.repository }}
          ARCHWEAVE_PR_NUMBER: \${{ github.event.pull_request.number }}
          ARCHWEAVE_MAX_ROUNDS: '5'
          ARCHWEAVE_LOCALE: 'ko'
          ARCHWEAVE_HEAD_SHA: \${{ github.event.pull_request.head.sha }}
          ARCHWEAVE_ROUND_AFTER_ID: \${{ needs.ai-review.outputs.last-comment-id }}
          ARCHWEAVE_VERDICT_OUTPUT: 'github-output'
        run: |
          if [ -x node_modules/.bin/archweave-review-verdict ]; then
            node_modules/.bin/archweave-review-verdict
          else
            echo "nx-archweave is not installed in this workspace - skipping the verdict gate."
          fi

      - name: Fail the review check
        if: steps.verdict.outputs.blocked == 'true'
        env:
          BLOCK_REASON: \${{ steps.verdict.outputs.block-reason }}
        run: |
          case "$BLOCK_REASON" in
            block) echo "The AI verdict is BLOCK: fix the P0/P1 findings in the verdict comment and push." ;;
            no-summary) echo "The AI review posted no summary for this commit, so there is no verdict. Re-run all jobs to review it again, or review it yourself." ;;
            unreadable) echo "The AI review summary has no readable findings block, so there is no verdict. Re-run all jobs to review it again, or review it yourself." ;;
            *) echo "The review check failed. See the verdict comment on this pull request." ;;
          esac
          exit 1

  review-comment:
    needs: review
    if: \${{ !cancelled() && needs.review.outputs.comment-body != '' }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      pull-requests: write
    steps:
      - name: Post review verdict
        env:
          GH_TOKEN: \${{ github.token }}
          REPOSITORY: \${{ github.repository }}
          PR_NUMBER: \${{ github.event.pull_request.number }}
          VERDICT_BODY: \${{ needs.review.outputs.comment-body }}
          PREVIOUS_ID: \${{ needs.review.outputs.previous-comment-id }}
        run: |
          payload=$(jq -n --arg body "$VERDICT_BODY" '{body: $body}')
          if [ -z "$PREVIOUS_ID" ]; then
            PREVIOUS_ID=$(gh api "repos/$REPOSITORY/issues/$PR_NUMBER/comments" --paginate --jq '.[] | select(.user.login == "github-actions[bot]") | select(.body | contains("<!-- archweave-verdict -->")) | .id' | tail -n 1) || PREVIOUS_ID=
          fi
          case "$PREVIOUS_ID" in
            ''|*[!0-9]*) PREVIOUS_ID= ;;
          esac
          if [ -n "$PREVIOUS_ID" ] && printf '%s' "$payload" | gh api -X PATCH "repos/$REPOSITORY/issues/comments/$PREVIOUS_ID" --input - > /dev/null; then
            exit 0
          fi
          printf '%s' "$payload" | gh api -X POST "repos/$REPOSITORY/issues/$PR_NUMBER/comments" --input - > /dev/null \\
            || echo "Could not post the verdict comment (continuing)."
"
`;

exports[`geminiProvider standard mode: skeleton, gates, action, prompt input, single review prompt 1`] = `
"name: Gemini Code Review

on:
  pull_request:
    types: [opened, synchronize, ready_for_review, reopened]

concurrency:
  group: archweave-review-\${{ github.event.pull_request.number }}
  cancel-in-progress: false

permissions: {}

jobs:
  ai-review:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: write
    outputs:
      enabled: \${{ steps.secret-gate.outputs.enabled }}
      allowed: \${{ steps.round-gate.outputs.allowed }}
      last-comment-id: \${{ steps.round-gate.outputs.last-comment-id }}
    steps:
      - name: Check review secret
        id: secret-gate
        env:
          REVIEW_SECRET: \${{ secrets.GEMINI_API_KEY }}
        run: |
          if [ -z "$REVIEW_SECRET" ]; then
            echo "AI review is not active: register the GEMINI_API_KEY secret to enable it."
            echo "enabled=false" >> "$GITHUB_OUTPUT"
          else
            echo "enabled=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Check review round limit
        id: round-gate
        if: steps.secret-gate.outputs.enabled == 'true'
        env:
          GH_TOKEN: \${{ github.token }}
        run: |
          counts=$(gh api "repos/\${{ github.repository }}/issues/\${{ github.event.pull_request.number }}/comments" --paginate --jq '[([.[] | select(.user.type == "Bot") | select(.body | contains("<!-- archweave-review-round -->"))] | length), ([.[].id] | max // 0)]' | jq -s -r '[(map(.[0]) | add // 0), (map(.[1]) | max // 0)] | @tsv')
          rounds=$(printf '%s' "$counts" | cut -f1)
          echo "last-comment-id=$(printf '%s' "$counts" | cut -f2)" >> "$GITHUB_OUTPUT"
          if [ "$rounds" -ge 3 ]; then
            echo "Automated review round limit (3) reached for this PR; skipping."
            echo "allowed=false" >> "$GITHUB_OUTPUT"
          else
            echo "allowed=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Checkout repository
        if: steps.secret-gate.outputs.enabled == 'true' && steps.round-gate.outputs.allowed == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false

      - name: Run Gemini review
        if: steps.secret-gate.outputs.enabled == 'true' && steps.round-gate.outputs.allowed == 'true'
        uses: google-github-actions/run-gemini-cli@f77273f4c914e4bf38440cf36a0369cb64a37489 # v0.1.22
        env:
          GITHUB_TOKEN: \${{ github.token }}
          GEMINI_CLI_TRUST_WORKSPACE: 'true'
        with:
          gemini_api_key: \${{ secrets.GEMINI_API_KEY }}
          gemini_cli_version: '0.65.0'
          prompt: |
            Review the diff of this pull request using \`gh pr diff\` and \`gh pr view\`.
            Post specific findings as inline comments and exactly one top-level summary comment.
            Always include the literal marker <!-- archweave-review-round --> in the top-level summary comment.
            If there are no findings that require action, post exactly one top-level comment saying so (and still include the marker).
            Do not modify any code, and never approve or merge the pull request.
            Write summaries and explanations in English; keep file names, function names, and identifiers verbatim.

            ---

            You are a code reviewer focused on correctness and security.

            Review the provided diff and report findings in two explicitly separated top-level sections: "Correctness" and "Security". Never mix the two.

            Only report findings with priority P0, P1, P2, Nit. Do NOT report P3 (over-engineering) findings — they are covered by a separate reviewer and are out of scope here.

            For every finding, fill in every field of this schema:
            - priority: P0 | P1 | P2 | Nit
            - category: kebab-case category name
            - title: one-line summary
            - file: path of the affected file
            - lineRange: { start, end? }
            - evidence: what in the code proves the problem
            - impact: what goes wrong and for whom
            - reproductionCondition: the exact input/state that triggers it
            - recommendation: the concrete fix
            - confidence: confirmed | plausible

            If multiple findings share the same root cause, merge them into a single finding instead of reporting duplicates.

            ---

            At the END of the top-level summary comment, append the machine-readable findings block:
            the literal marker line <!-- archweave-findings-v1 -->, then a fenced \`\`\`json block containing
            { "schema": "archweave/findings@1", "findings": [ ... ] } with one entry per finding,
            using exactly the finding schema above. If there are no findings, still append the block with an empty findings array.

  review:
    needs: ai-review
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
    outputs:
      comment-body: \${{ steps.verdict.outputs.comment-body || steps.ai-review-result.outputs.notice-body }}
      previous-comment-id: \${{ steps.verdict.outputs.previous-comment-id }}
    steps:
      - name: Check the AI review result
        id: ai-review-result
        env:
          AI_REVIEW_RESULT: \${{ needs.ai-review.result }}
          REVIEW_ENABLED: \${{ needs.ai-review.outputs.enabled }}
          REVIEW_ALLOWED: \${{ needs.ai-review.outputs.allowed }}
          LAST_COMMENT_ID: \${{ needs.ai-review.outputs.last-comment-id }}
          HEAD_SHA: \${{ github.event.pull_request.head.sha }}
          HEAD_REPOSITORY: \${{ github.event.pull_request.head.repo.full_name }}
          REPOSITORY: \${{ github.repository }}
          PR_AUTHOR: \${{ github.event.pull_request.user.login }}
        run: |
          not_run() {
            case "$1" in
              secret) annotation='AI review did not run for this commit (the GEMINI_API_KEY secret is not registered). A green check here does not mean the change was reviewed.'; notice='AI review did not run for this commit (the GEMINI_API_KEY secret is not registered). A green check here does not mean the change was reviewed.' ;;
              fork) annotation='AI review did not run for this commit (this pull request comes from a fork, and GitHub passes no secrets to runs from forks). A green check here does not mean the change was reviewed.'; notice='AI review did not run for this commit (this pull request comes from a fork, and GitHub passes no secrets to runs from forks). A green check here does not mean the change was reviewed.' ;;
              dependabot) annotation='AI review did not run for this commit (Dependabot runs receive only Dependabot secrets, and GEMINI_API_KEY is not one of them). A green check here does not mean the change was reviewed.'; notice='AI review did not run for this commit (Dependabot runs receive only Dependabot secrets, and GEMINI_API_KEY is not one of them). A green check here does not mean the change was reviewed.' ;;
              rounds) annotation='AI review did not run for this commit (the automated review round limit (3) is reached). A green check here does not mean the change was reviewed.'; notice='AI review did not run for this commit (the automated review round limit (3) is reached). A green check here does not mean the change was reviewed.' ;;
            esac
            echo "::notice title=AI review did not run::$annotation"
            printf '%s\\n' "$notice" >> "$GITHUB_STEP_SUMMARY"
            short_sha=$(printf '%s' "$HEAD_SHA" | cut -c1-7)
            case "$short_sha" in
              '' | *[!0-9a-f]*) short_sha= ;;
            esac
            {
              echo "notice-body<<ARCHWEAVE_NOT_RUN_EOF"
              printf '%s\\n' '<!-- archweave-verdict -->' "ℹ️ $notice"
              if [ -n "$short_sha" ]; then printf '\\n%s\\n' '<sub>Commit \`'"$short_sha"'\` · this comment is updated on every review round.</sub>'; fi
              echo "ARCHWEAVE_NOT_RUN_EOF"
              echo "run=false"
            } >> "$GITHUB_OUTPUT"
          }
          if [ "$AI_REVIEW_RESULT" != success ]; then
            echo "::error title=AI review did not succeed::The AI review job ended with '$AI_REVIEW_RESULT'."
            exit 1
          fi
          case "$REVIEW_ENABLED/$REVIEW_ALLOWED" in
            false/*)
              if [ "$HEAD_REPOSITORY" != "$REPOSITORY" ]; then not_run fork
              elif [ "$PR_AUTHOR" = 'dependabot[bot]' ]; then not_run dependabot
              else not_run secret
              fi
              exit 0
              ;;
            true/false)
              not_run rounds
              exit 0
              ;;
            true/true)
              case "$LAST_COMMENT_ID" in
                '' | *[!0-9]*) ;;
                *)
                  echo "run=true" >> "$GITHUB_OUTPUT"
                  exit 0
                  ;;
              esac
              ;;
          esac
          echo "::error title=Review verdict not computed::The AI review job's results did not reach this job, so no verdict can be computed. Re-run all jobs."
          exit 1

      - name: Checkout repository
        if: steps.ai-review-result.outputs.run == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 1
          persist-credentials: false

      - name: Detect pnpm version
        id: pnpm-version
        if: steps.ai-review-result.outputs.run == 'true'
        run: |
          if [ -n "$(jq -r '.packageManager // empty' package.json)" ]; then
            echo "version=" >> "$GITHUB_OUTPUT"
          else
            echo "version=10" >> "$GITHUB_OUTPUT"
          fi

      - name: Set up pnpm
        if: steps.ai-review-result.outputs.run == 'true'
        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
        with:
          version: \${{ steps.pnpm-version.outputs.version }}

      - name: Set up Node
        if: steps.ai-review-result.outputs.run == 'true'
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          cache: pnpm

      - name: Install workspace dependencies
        if: steps.ai-review-result.outputs.run == 'true'
        run: |
          pnpm install --frozen-lockfile --ignore-scripts

      - name: Compute review verdict
        id: verdict
        if: steps.ai-review-result.outputs.run == 'true'
        env:
          GH_TOKEN: \${{ github.token }}
          GITHUB_REPOSITORY: \${{ github.repository }}
          ARCHWEAVE_PR_NUMBER: \${{ github.event.pull_request.number }}
          ARCHWEAVE_MAX_ROUNDS: '3'
          ARCHWEAVE_LOCALE: 'en'
          ARCHWEAVE_HEAD_SHA: \${{ github.event.pull_request.head.sha }}
          ARCHWEAVE_ROUND_AFTER_ID: \${{ needs.ai-review.outputs.last-comment-id }}
          ARCHWEAVE_VERDICT_OUTPUT: 'github-output'
        run: |
          if [ -x node_modules/.bin/archweave-review-verdict ]; then
            node_modules/.bin/archweave-review-verdict
          else
            echo "nx-archweave is not installed in this workspace - skipping the verdict gate."
          fi

      - name: Fail the review check
        if: steps.verdict.outputs.blocked == 'true'
        env:
          BLOCK_REASON: \${{ steps.verdict.outputs.block-reason }}
        run: |
          case "$BLOCK_REASON" in
            block) echo "The AI verdict is BLOCK: fix the P0/P1 findings in the verdict comment and push." ;;
            no-summary) echo "The AI review posted no summary for this commit, so there is no verdict. Re-run all jobs to review it again, or review it yourself." ;;
            unreadable) echo "The AI review summary has no readable findings block, so there is no verdict. Re-run all jobs to review it again, or review it yourself." ;;
            *) echo "The review check failed. See the verdict comment on this pull request." ;;
          esac
          exit 1

  review-comment:
    needs: review
    if: \${{ !cancelled() && needs.review.outputs.comment-body != '' }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      pull-requests: write
    steps:
      - name: Post review verdict
        env:
          GH_TOKEN: \${{ github.token }}
          REPOSITORY: \${{ github.repository }}
          PR_NUMBER: \${{ github.event.pull_request.number }}
          VERDICT_BODY: \${{ needs.review.outputs.comment-body }}
          PREVIOUS_ID: \${{ needs.review.outputs.previous-comment-id }}
        run: |
          payload=$(jq -n --arg body "$VERDICT_BODY" '{body: $body}')
          if [ -z "$PREVIOUS_ID" ]; then
            PREVIOUS_ID=$(gh api "repos/$REPOSITORY/issues/$PR_NUMBER/comments" --paginate --jq '.[] | select(.user.login == "github-actions[bot]") | select(.body | contains("<!-- archweave-verdict -->")) | .id' | tail -n 1) || PREVIOUS_ID=
          fi
          case "$PREVIOUS_ID" in
            ''|*[!0-9]*) PREVIOUS_ID= ;;
          esac
          if [ -n "$PREVIOUS_ID" ] && printf '%s' "$payload" | gh api -X PATCH "repos/$REPOSITORY/issues/comments/$PREVIOUS_ID" --input - > /dev/null; then
            exit 0
          fi
          printf '%s' "$payload" | gh api -X POST "repos/$REPOSITORY/issues/$PR_NUMBER/comments" --input - > /dev/null \\
            || echo "Could not post the verdict comment (continuing)."
"
`;
