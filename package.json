    "@swc/jest": "~0.2.38",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.3.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.7",
